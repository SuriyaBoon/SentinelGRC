  "instruction_cases": [
    {
      "name": "tab_command_separator",
      "dockerfile": "FROM\tscratch\n",
      "escape_character": "\\",
      "instructions": [["FROM", "scratch"]]
    },
    {
      "name": "vertical_tab_command_separator",
      "dockerfile": "FROM\u000bscratch\n",
      "escape_character": "\\",
      "instructions": [["FROM", "scratch"]]
    },
    {
      "name": "form_feed_command_separator",
      "dockerfile": "FROM\fscratch\n",
      "escape_character": "\\",
      "instructions": [["FROM", "scratch"]]
    },
    {
      "name": "unicode_leading_whitespace",
      "dockerfile": "\u00a0\u2003FROM scratch\n",
      "escape_character": "\\",
      "instructions": [["FROM", "scratch"]]
    },
    {
      "name": "continuation_indentation_preserved",
      "dockerfile": "RUN echo first \\\n  && echo second\n",
      "escape_character": "\\",
      "instructions": [["RUN", "echo first   && echo second"]]
    },
    {
      "name": "pre_escape_spaces_preserved",
      "dockerfile": "RUN echo first   \\\n&& echo second\n",
      "escape_character": "\\",
      "instructions": [["RUN", "echo first   && echo second"]]
    },
    {
      "name": "continuation_comment_is_ignored",
      "dockerfile": "COPY app.py \\\n  # ignored comment\n  helper.py /app/\n",
      "escape_character": "\\",
      "instructions": [["COPY", "app.py   helper.py /app/"]]
    },
    {
      "name": "control_separator_preserved_in_argument",
      "dockerfile": "FROM scratch\nRUN \u001fpayload\u001f\n",
      "escape_character": "\\",
      "instructions": [["FROM", "scratch"], ["RUN", "\u001fpayload\u001f"]]
    },
    {
      "name": "backtick_continuation",
      "dockerfile": "# escape=`\nRUN echo first `\n  && echo second\n",
      "escape_character": "`",
      "instructions": [["RUN", "echo first   && echo second"]]
    }
  ],
