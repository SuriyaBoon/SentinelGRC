{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SuriyaBoon/SentinelGRC/schemas/asset-context.v1.schema.json",
  "title": "SentinelGRC canonical asset context v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source", "source_asset_id", "observed_at", "asset_id", "owner", "criticality", "status", "evidence_refs"],
  "properties": {
    "schema_version": { "const": "asset_context.v1" },
    "source": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
    "source_asset_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
    "observed_at": { "type": "string", "format": "date-time" },
    "asset_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
    "hostname": { "type": ["string", "null"], "minLength": 1, "maxLength": 255 },
    "owner": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
    "criticality": { "enum": ["low", "medium", "high", "critical"] },
    "status": { "enum": ["active", "inactive", "retired", "unknown"] },
    "evidence_refs": { "type": "array", "minItems": 1, "maxItems": 20, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 512 } }
  }
}
