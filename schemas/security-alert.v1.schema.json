{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SuriyaBoon/SentinelGRC/schemas/security-alert.v1.schema.json",
  "title": "SentinelGRC canonical security alert v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source",
    "source_event_id",
    "observed_at",
    "asset_id",
    "kind",
    "severity",
    "title",
    "risk_owner",
    "event_code",
    "evidence_refs"
  ],
  "properties": {
    "schema_version": { "const": "security_alert.v1" },
    "source": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$" },
    "source_event_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
    "observed_at": { "type": "string", "format": "date-time" },
    "asset_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
    "kind": { "enum": ["brute_force", "account_lockout", "privilege_escalation"] },
    "severity": { "enum": ["low", "medium", "high", "critical"] },
    "title": { "type": "string", "minLength": 1, "maxLength": 512 },
    "risk_owner": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
    "event_code": { "enum": [4625, 4740, 4672] },
    "source_ip": { "type": ["string", "null"], "format": "ip" },
    "target_user": { "type": ["string", "null"], "minLength": 1, "maxLength": 256 },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 512 }
    }
  }
}
